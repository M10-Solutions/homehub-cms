# Optional: copy to .env and adapt to your host. Do not commit .env.
HOMEHUB_UID=1000
HOMEHUB_GID=1001
HOMEHUB_PORT=8011
# Restrict to 127.0.0.1 for local setup or a local reverse proxy.
HOMEHUB_BIND_ADDRESS=0.0.0.0
HOMEHUB_TZ=Europe/Zurich
HOMEHUB_CONTAINER_NAME=homehub
HOMEHUB_IMAGE=homehub-local:latest
